{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.mjs": {
      "includeFiles": "dist/menu-seed.json"
    }
  },
  "rewrites": [
    { "source": "/api/admin/:route*", "destination": "/api/admin?__cafeInAdminRoute=:route*" },
    { "source": "/menu", "destination": "/" },
    { "source": "/menu/:path*", "destination": "/" },
    { "source": "/digital-menu", "destination": "/" },
    { "source": "/digital-menu/:path*", "destination": "/" }
  ]
}
